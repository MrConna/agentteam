# ============================================================================
# AI 灵感雷达 — 环境变量示例。复制为 .env 并按需填写。
# ============================================================================

# --- 数据源（RADAR-01 / Nitter RSS） ---------------------------------------
# 抓取的博主名单，逗号分隔。留空使用内置分类名单；设置后仍会按内置表补回分类。
AI_RADAR_USERNAMES=karpathy,fchollet,sama,ylecun,drfeifei,ID_AA_Carmack,elonmusk,jeremyphoward,lilianweng,polynoamial,goodside,simonw,deepseek_ai,ElevenLabs,GoogleAI,xai,cursor_ai,anthropicai,OpenClaw,theworldlabs,thinkymachines,chorus_agent,isoformai,wesight_ai,bcherny,leerob,mattpocockuk,milichab,ericzakariasson,ammaar,OfficialLoganK,jxnlco,gabriel1,trq212,fofrAI,gregisenberg,levelsio,jackfriks,corbin_braun,dontbesilent,xiaoxiaodong01,MissCat_AI,HiTw93,lxfater,yetone,CoderDaMing,MinLiBuilds,muskdashu,TinaLearning,godofprompt,bourneliu66,canghe,laobaishare,Zesee,lifesinger,knowledgefxg,songguoxiansen,trawasthi_ai
# 备用 Nitter 实例，逗号分隔（首选优先，失败自动 fallback）。
NITTER_HOSTS=https://nitter.net,https://nitter.poast.org
# 只取最近 N 小时内的推文，默认 24。
AI_RADAR_LOOKBACK_HOURS=24
AI_RADAR_NITTER_TIMEOUT_MS=15000

# --- LLM 处理器（RADAR-02） ------------------------------------------------
# 提供商：openai | deepseek | gemini
AI_RADAR_LLM_PROVIDER=openai
# 统一的 API Key（也可用 OPENAI_API_KEY / DEEPSEEK_API_KEY / GEMINI_API_KEY）。
AI_RADAR_LLM_API_KEY=sk-xxxx
# 可选：覆盖默认模型（openai=gpt-4o-mini, deepseek=deepseek-chat, gemini=gemini-2.0-flash）。
AI_RADAR_LLM_MODEL=
# 可选：自建/兼容网关根地址。
AI_RADAR_LLM_BASE_URL=
AI_RADAR_LLM_TEMPERATURE=0.2
AI_RADAR_LLM_TIMEOUT_MS=60000

# --- Obsidian 写入（RADAR-03） ---------------------------------------------
# 用户 Obsidian 库根目录。
AI_RADAR_VAULT_DIR=/Users/luffy/Downloads/code/Github/my_note
